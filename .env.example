# Alpaca paper trading credentials. Copy to .env and fill in.
# .env is gitignored and must never be committed.
#
# The account must be the fresh paper account created for the competition,
# funded at exactly $100,000, with options level 3 so multi-leg defined-risk
# spreads are permitted. scripts/preflight.py checks all three.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# CONVEX refuses to start when this is false. There is no live-money path.
ALPACA_PAPER=true

# The market is reached through Alpaca's MCP server, run as a child process.
# Leave this unset to use the copy installed in .venv; set it to point at
# another installation.
ALPACA_MCP_COMMAND=

# Featherless AI runs the rationale layer only. It never computes a number,
# and the agent trades normally when it is absent: the deterministic rationale
# is written to the ledger instead and the record says which one it was.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
