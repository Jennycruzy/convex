# 10:00 New York. The decision itself begins at the research-specified
# time. Its prerequisite calibration is scheduled separately at 09:55 and the
# service refuses if that fresh receipt is missing.
#
# Nothing here checks whether the market is open. Alpaca's calendar does, in
# both scripts, and a holiday stands the session down with a receipt.

[Unit]
Description=Run the CONVEX session on the research entry

[Timer]
OnCalendar=Mon-Fri 10:00 America/New_York
Persistent=false

[Install]
WantedBy=timers.target
