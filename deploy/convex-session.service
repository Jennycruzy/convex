# The decision begins at exactly 10:00 ET. Its calibration is a separate
# 09:55 service: this unit refuses to run if that service did not leave a fresh
# live-market receipt, rather than quietly using yesterday's threshold.
#
# Install with:
#   sudo cp deploy/convex-calibrate.* deploy/convex-session.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now convex-calibrate.timer convex-session.timer

[Unit]
Description=CONVEX 10:00 ET decision cycle
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/convex
Environment=HOME=/home/ubuntu
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/home/ubuntu/convex/.venv/bin/python -m scripts.assert_fresh_calibration --max-age-seconds=900
ExecStart=/home/ubuntu/convex/.venv/bin/python -m scripts.run_cycle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/convex/data /home/ubuntu/convex/config /home/ubuntu/convex/docs
ProtectHome=read-only
